# Deployer Wallet Private Key (BOT Chain Testnet)
PRIVATE_KEY=your_private_key_here

# Reown AppKit Project ID (https://cloud.reown.com)
VITE_REOWN_PROJECT_ID=your_reown_project_id_here

# Deployed Smart Contract Address (Populated after deploying)
VITE_CONTRACT_ADDRESS=

# BOT Chain Endpoints
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai

